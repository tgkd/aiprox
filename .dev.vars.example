# Local secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and fill in real values.
# NEVER put real values in this example file — it is committed. Real secrets live only in `.dev.vars`
# locally and in `wrangler secret put <NAME>` for prod.

# Shared bearer token the app sends as `Authorization: Bearer <APP_SECRET>`.
# Generate one with: openssl rand -base64 32
APP_SECRET="replace-me-with-a-random-secret"

# Nebius Token Factory key for /ai/txt2txt (see CLAUDE.md → Bindings & secrets).
AI_KEY="replace-me"

# Cloudflare AI-Gateway token (Run permission). All Replicate calls go through the gateway;
# the Replicate provider key itself is stored on the gateway's Provider Keys page, not here.
AI_GATEWAY_TOKEN="replace-me"
